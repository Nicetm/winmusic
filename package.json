{
  "name": "winmusic",
  "version": "1.2.2",
  "description": "Reproductor de audio y video estilo Winamp",
  "author": "winMusic",
  "main": "dist-electron/main/index.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && electron-builder --publish never",
    "build:dir": "tsc --noEmit && vite build && electron-builder --dir --publish never",
    "publish": "tsc --noEmit && vite build && electron-builder --publish always",
    "release:patch": "npm version patch --no-git-tag-version && npm run publish",
    "release:minor": "npm version minor --no-git-tag-version && npm run publish",
    "release:major": "npm version major --no-git-tag-version && npm run publish",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
